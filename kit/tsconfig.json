{
  "extends": "@wirecat/cli-base/tsconfig.base.json",
  // The kit ships as a bin without its sources, so declarations and source maps would only add dead files.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
