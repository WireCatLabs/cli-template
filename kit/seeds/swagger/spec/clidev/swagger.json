{
  "swagger": "2.0",
  "info": { "title": "Example Comments", "version": "1" },
  "host": "comments.example.invalid",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "token": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://comments.example.invalid/oauth/authorize",
      "scopes": {}
    }
  },
  "security": [{ "token": [] }],
  "paths": {
    "/comments": {
      "get": {
        "operationId": "listComments",
        "tags": ["Comments"],
        "summary": "List comments, newest first",
        "parameters": [
          { "name": "limit", "in": "query", "type": "integer", "minimum": 1, "maximum": 100 },
          { "name": "start_cursor", "in": "query", "type": "string" }
        ],
        "responses": {
          "200": { "description": "A page of comments", "schema": { "$ref": "#/definitions/CommentList" } }
        }
      },
      "post": {
        "operationId": "createComment",
        "tags": ["Comments"],
        "summary": "Create a comment",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/NewComment" } }
        ],
        "responses": { "201": { "description": "The comment", "schema": { "$ref": "#/definitions/Comment" } } }
      }
    },
    "/comments/{comment_id}": {
      "parameters": [{ "name": "comment_id", "in": "path", "required": true, "type": "string" }],
      "get": {
        "operationId": "getComment",
        "tags": ["Comments"],
        "summary": "Show one comment",
        "responses": { "200": { "description": "The comment", "schema": { "$ref": "#/definitions/Comment" } } }
      },
      "patch": {
        "operationId": "updateComment",
        "tags": ["Comments"],
        "summary": "Change a comment's text",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/NewComment" } }
        ],
        "responses": { "200": { "description": "The comment", "schema": { "$ref": "#/definitions/Comment" } } }
      },
      "delete": {
        "operationId": "deleteComment",
        "tags": ["Comments"],
        "summary": "Delete a comment",
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  },
  "definitions": {
    "NewComment": {
      "type": "object",
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1 } }
    },
    "Comment": {
      "type": "object",
      "required": ["id", "text", "author", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "CommentList": {
      "type": "object",
      "required": ["results", "has_more"],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/definitions/Comment" } },
        "has_more": { "type": "boolean" },
        "next_cursor": { "type": "string" }
      }
    }
  }
}
